{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "CRM FastAPI",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080", "--reload"],
      "port": 8080,
      "autoPort": false
    },
    {
      "name": "CRM Frontend",
      "cwd": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    }
  ]
}
