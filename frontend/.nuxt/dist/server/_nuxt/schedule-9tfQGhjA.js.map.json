{"file":"schedule-9tfQGhjA.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;AAoHA,UAAM,EAAE,IAAA,IAAQ,OAAA;AAChB,UAAM,MAAM,UAAA;AACZ,UAAM,EAAE,MAAM,SAAS,aAAY,CAAA,QAAA,SAAA,IAAAA,iBAAA,MAAM,aAAa,YAAY,MAAM,IAAI,cAAc,GAAG,EAAE,QAAQ,MAAA,CAAO,CAAA;AAE9G,UAAM,WAAe,SAAS,MAAM,KAAK,OAAO,YAAY,EAAE;AAC9D,UAAM,eAAgB,SAAS,MAAM,SAAS,MAAM,OAAO,CAAC,MAAW,EAAE,cAAc,SAAS,CAAC;AACjG,UAAM,aAAgB,SAAS,MAAM,SAAS,MAAM,OAAO,CAAC,MAAW,EAAE,cAAc,OAAO,CAAC;AAC/F,UAAM,gBAAgB,SAAS,MAAM,SAAS,MAAM,OAAO,CAAC,MAAW,EAAE,cAAc,UAAU,CAAC;AAElG,UAAM,iBAAiB,SAAS,MAAM;AAAA,MACpC,EAAE,QAAQ,WAAY,OAAO,WAAkB,MAAM,yBAAyB,OAAO,aAAa,MAAA;AAAA,MAClG,EAAE,QAAQ,SAAY,OAAO,mBAAmB,MAAM,mBAAyB,OAAO,WAAW,MAAA;AAAA,MACjG,EAAE,QAAQ,YAAY,OAAO,aAAmB,MAAM,oBAAyB,OAAO,cAAc,MAAA;AAAA,IAAM,CAC3G;AAED,aAAS,aAAa,SAAiB;AACrC,UAAI,CAAC,QAAS,QAAO;AACrB,YAAM,OAAO,KAAK,OAAO,KAAK,QAAQ,IAAI,KAAK,OAAO,EAAE,QAAA,KAAa,KAAQ;AAC7E,aAAO,OAAO,IAAI,OAAO;AAAA,IAC3B;;;gNAlIoCC,eAAAC,MAAA,IAAA,GAAM,SAAK,CAAA,sBAA6BD,eAAAC,MAAA,IAAA,GAAM,IAAI,SAAWD,eAAAC,MAAA,IAAA,GAAM,EAAE,wEAElCA,MAAA,OAAA,CAAO,IAAA,cAAA,qDACrCA,MAAA,OAAA,IAAO,YAAA,EAAA,EAAA;UAIjCA,MAAA,OAAA,GAAO;;iBAIGA,MAAA,IAAA,GAAI;4EAKRC,eAAA,CAAAD,MAAA,YAAA,EAAa,SAAM,oCAAA,mBAAA,+CAAA,CAAA,gBACoBC,eAAA,CAAAD,MAAA,YAAA,EAAa,SAAM,iBAAA,iBAAA,gCAAA,CAAA,2BAE5BC,eAAA,CAAAD,MAAA,YAAA,EAAa,SAAM,iBAAA,iBAAA,mBAAA,CAAA,MACrDD,eAAAC,MAAA,YAAA,EAAa,MAAM,mGAMfC,eAAA,CAAAD,MAAA,UAAA,EAAW,SAAM,0CAAA,mBAAA,+CAAA,CAAA,gBACgBC,eAAA,CAAAD,MAAA,UAAA,EAAW,SAAM,oBAAA,iBAAA,0BAAA,CAAA,2BAEpBC,eAAA,CAAAD,MAAA,UAAA,EAAW,SAAM,oBAAA,iBAAA,mBAAA,CAAA,MACnDD,eAAAC,MAAA,UAAA,EAAW,MAAM,4QAQ0BD,eAAAC,MAAA,aAAA,EAAc,MAAM,uDAC9BD,eAAAC,MAAA,IAAA,EAAK,IAAI;AAM3BE,sBAAAF,MAAA,cAAA,IAAT,UAAK;;cACT,MAAM,MAAM,QAAM;mDAEdC,eAAA,CAAA,MAAM,WAAM,YAAA,iBAAkC,MAAM,WAAM,UAAA,oBAAA,iBAAA,oBAAA,CAAA,gBAC9CA,eAAA,YAAA,MAAM,IAAI,SAAA,WAC9BF,eAAA,MAAM,KAAK,qBAAQ,MAAM,MAAM,MAAM;0BAgBpB,MAAM,OAAK,CAAhB,MAAC;AACA,oBAAA,cAAAE,eAAA,MAAM,WAAM,YAAA,iBAAkC,MAAM,WAAM,UAAA,oBAAA,EAAA,CAAA,QAAA;;gBAEvD,IAAE,aAAe,EAAE,OAAO;AAAA,gBAAI,OAAM;AAAA,cAAA;iCAA/C,CAEW,GAAAE,QAAAC,UAAA,aAAA;;AADND,2BAAA,GAAAJ,eAAA,EAAE,YAAY,CAAA,EAAA;AAAA;;sBAAdM,gBAAAC,gBAAA,EAAE,YAAY,GAAA,CAAA;AAAA,oBAAA;AAAA;;;;AAER,kBAAA,EAAE,SAAO;AAA0C,sBAAA,6CAAAP,eAAA,EAAE,OAAO,CAAA,QAAA;AAAA;;;6CAEvDE,eAAAD,MAAA,GAAA,EAAI,WAAW,EAAE,KAAK,CAAA,MAAMD,eAAA,EAAE,KAAK,iCACnCE,eAAAD,MAAA,GAAA,EAAI,cAAc,EAAE,SAAS,CAAA,MAAMD,eAAA,EAAE,SAAS,2BAEpDE,eAAA,CAAA,MAAM,WAAM,YAAA,iBAAkC,MAAM,WAAM,UAAA,oBAAA,iBAAA,qBAAA,CAAA,MACjEF,eAAAC,MAAA,GAAA,EAAI,IAAI,EAAE,YAAY,CAAA;AACb,kBAAA,MAAM,WAAM,WAAA;4EACnB,aAAa,EAAE,YAAY,CAAA,CAAA,oBAAA;AAAA;;;8DAGGD,eAAA,EAAE,eAAW,GAAA,qEACaA,eAAAC,MAAA,GAAA,EAAI,OAAO,EAAE,aAAa,CAAA;;gBAE5E,IAAE,aAAe,EAAE,OAAO;AAAA,gBAC3B,OAAM;AAAA,cAAA;iCADhB,CAGW,GAAAG,QAAAC,UAAA,aAAA;;;;;sCAFyE,QAEpF;AAAA,oBAAA;AAAA;;;;;;;;;;;;;AAUF,YAAA,CAAAJ,MAAA,IAAA,EAAK,OAAK;;;;;;;;;;;;;;;;;;;","names":["_withAsyncContext","_ssrInterpolate","_unref","_ssrRenderClass","_ssrRenderList","_push","_parent","_createTextVNode","_toDisplayString"],"sources":["../../../../pages/schedule.vue"],"sourcesContent":["<template>\n  <div>\n    <div class=\"page-header mb-5\">\n      <div>\n        <h1 class=\"page-title\"><i class=\"fa-solid fa-calendar-check text-primary-400 mr-2\" />FU Schedule</h1>\n        <p class=\"page-subtitle\">{{ data?.total ?? 0 }} lead terjadwal · {{ data?.from }} s/d {{ data?.to }}</p>\n      </div>\n      <button @click=\"refresh\" class=\"btn-secondary btn-sm\" :disabled=\"pending\">\n        <i :class=\"`fa-solid fa-rotate ${pending ? 'fa-spin' : ''}`\" />Refresh\n      </button>\n    </div>\n\n    <div v-if=\"pending\" class=\"flex justify-center py-16\">\n      <i class=\"fa-solid fa-circle-notch fa-spin text-3xl text-primary-400\" />\n    </div>\n\n    <template v-else-if=\"data\">\n\n      <!-- Summary chips -->\n      <div class=\"flex flex-wrap gap-3 mb-5\">\n        <div class=\"card-sm flex items-center gap-2.5 px-4 border\"\n             :class=\"overdueItems.length ? 'border-red-700/50 bg-red-900/10' : 'border-navy-700'\">\n          <i class=\"fa-solid fa-circle-exclamation\" :class=\"overdueItems.length ? 'text-red-400' : 'text-gray-600'\" />\n          <div>\n            <div class=\"text-sm font-bold\" :class=\"overdueItems.length ? 'text-red-300' : 'text-gray-500'\">\n              {{ overdueItems.length }} Overdue\n            </div>\n            <div class=\"text-xs text-gray-600\">Melewati jadwal</div>\n          </div>\n        </div>\n        <div class=\"card-sm flex items-center gap-2.5 px-4 border\"\n             :class=\"todayItems.length ? 'border-yellow-700/50 bg-yellow-900/10' : 'border-navy-700'\">\n          <i class=\"fa-solid fa-calendar-day\" :class=\"todayItems.length ? 'text-yellow-400' : 'text-gray-600'\" />\n          <div>\n            <div class=\"text-sm font-bold\" :class=\"todayItems.length ? 'text-yellow-300' : 'text-gray-500'\">\n              {{ todayItems.length }} Hari Ini\n            </div>\n            <div class=\"text-xs text-gray-600\">Jadwal hari ini</div>\n          </div>\n        </div>\n        <div class=\"card-sm flex items-center gap-2.5 px-4 border border-navy-700\">\n          <i class=\"fa-solid fa-calendar-week text-blue-400\" />\n          <div>\n            <div class=\"text-sm font-bold text-blue-300\">{{ upcomingItems.length }} Mendatang</div>\n            <div class=\"text-xs text-gray-600\">{{ data.days }} hari ke depan</div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Groups -->\n      <template v-for=\"group in scheduleGroups\" :key=\"group.status\">\n        <div v-if=\"group.items.length\" class=\"mb-6\">\n          <div class=\"section-title mb-3\"\n               :class=\"group.status === 'Overdue' ? 'text-red-400' : group.status === 'Today' ? 'text-yellow-400' : 'text-blue-400'\">\n            <i :class=\"`fa-solid ${group.icon} mr-1.5`\" />\n            {{ group.label }} ({{ group.items.length }})\n          </div>\n          <div class=\"card overflow-x-auto\">\n            <table class=\"tbl\">\n              <thead>\n                <tr>\n                  <th>Perusahaan</th>\n                  <th>Stage</th>\n                  <th>Prioritas</th>\n                  <th>Next FU</th>\n                  <th>Sales</th>\n                  <th class=\"text-right\">Nilai</th>\n                  <th></th>\n                </tr>\n              </thead>\n              <tbody>\n                <tr v-for=\"l in group.items\" :key=\"l.lead_id\"\n                    :class=\"group.status === 'Overdue' ? 'bg-red-900/5' : group.status === 'Today' ? 'bg-yellow-900/5' : ''\">\n                  <td>\n                    <NuxtLink :to=\"`/pipeline/${l.lead_id}`\" class=\"text-primary-300 hover:text-primary-200 font-medium\">\n                      {{ l.nama_company }}\n                    </NuxtLink>\n                    <div v-if=\"l.product\" class=\"text-xs text-gray-600 mt-0.5\">{{ l.product }}</div>\n                  </td>\n                  <td><span :class=\"fmt.stageClass(l.stage)\">{{ l.stage }}</span></td>\n                  <td><span :class=\"fmt.priorityClass(l.prioritas)\">{{ l.prioritas }}</span></td>\n                  <td class=\"text-xs font-medium\"\n                      :class=\"group.status === 'Overdue' ? 'text-red-400' : group.status === 'Today' ? 'text-yellow-400' : 'text-blue-400'\">\n                    {{ fmt.tgl(l.next_fu_date) }}\n                    <span v-if=\"group.status === 'Overdue'\" class=\"block text-red-500/70\">\n                      {{ overdayCount(l.next_fu_date) }} hari lalu\n                    </span>\n                  </td>\n                  <td class=\"text-xs text-gray-400\">{{ l.sales_owner || '—' }}</td>\n                  <td class=\"text-right text-xs text-primary-300 font-medium\">{{ fmt.rupiah(l.propose_value) }}</td>\n                  <td class=\"text-right\">\n                    <NuxtLink :to=\"`/pipeline/${l.lead_id}`\"\n                              class=\"text-xs text-primary-400 hover:text-primary-300 whitespace-nowrap\">\n                      FU →\n                    </NuxtLink>\n                  </td>\n                </tr>\n              </tbody>\n            </table>\n          </div>\n        </div>\n      </template>\n\n      <!-- Empty state -->\n      <div v-if=\"!data.total\" class=\"card text-center py-12\">\n        <i class=\"fa-solid fa-calendar-check text-emerald-400 text-4xl mb-3 block\" />\n        <div class=\"text-base font-semibold text-gray-300 mb-1\">Tidak ada jadwal FU</div>\n        <div class=\"text-sm text-gray-500\">Semua follow-up sudah terlaksana atau belum ada yang dijadwalkan</div>\n      </div>\n\n    </template>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\ndefinePageMeta({ middleware: 'auth' })\nconst { get } = useApi()\nconst fmt = useFormat()\nconst { data, pending, refresh } = await useAsyncData('schedule', () => get('/v1/schedule'), { server: false })\n\nconst allItems     = computed(() => data.value?.schedule ?? [])\nconst overdueItems  = computed(() => allItems.value.filter((l: any) => l.fu_status === 'Overdue'))\nconst todayItems    = computed(() => allItems.value.filter((l: any) => l.fu_status === 'Today'))\nconst upcomingItems = computed(() => allItems.value.filter((l: any) => l.fu_status === 'Upcoming'))\n\nconst scheduleGroups = computed(() => [\n  { status: 'Overdue',  label: 'Overdue',        icon: 'fa-circle-exclamation', items: overdueItems.value },\n  { status: 'Today',    label: 'Jadwal Hari Ini', icon: 'fa-calendar-day',       items: todayItems.value },\n  { status: 'Upcoming', label: 'Mendatang',       icon: 'fa-calendar-week',      items: upcomingItems.value },\n])\n\nfunction overdayCount(dateStr: string) {\n  if (!dateStr) return 0\n  const diff = Math.floor((Date.now() - new Date(dateStr).getTime()) / 86400000)\n  return diff > 0 ? diff : 0\n}\n</script>\n"],"version":3}