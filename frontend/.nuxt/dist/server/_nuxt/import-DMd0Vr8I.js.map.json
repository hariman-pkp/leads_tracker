O,sBAAoB;AAAA,oBAAA;oBAC/GA,YAAwH,OAAA,MAAA;AAAA,sBAAnHA,YAAmC,QAAA,EAA7B,OAAM,eAAA,GAAe,GAAC;AAAA;sBAAQA,YAAoD,QAAA,EAA9C,OAAM,mBAAA,GAAmB,gBAAc;AAAA,sCAAO,uBAAqB;AAAA,oBAAA;oBAClHA,YAA2H,OAAA,MAAA;AAAA,sBAAtHA,YAAoC,QAAA,EAA9B,OAAM,gBAAA,GAAgB,GAAC;AAAA;sBAAQA,YAA8C,QAAA,EAAxC,OAAM,gBAAA,GAAgB,aAAW;AAAA,sCAAO,+BAA6B;AAAA,oBAAA;oBACrHA,YAAuH,OAAA,MAAA;AAAA,sBAAlHA,YAAoC,QAAA,EAA9B,OAAM,gBAAA,GAAgB,GAAC;AAAA;sBAAQA,YAA4C,QAAA,EAAtC,OAAM,gBAAA,GAAgB,WAAS;AAAA,sCAAO,6BAA2B;AAAA,oBAAA;oBACjHA,YAA8H,OAAA,MAAA;AAAA,sBAAzHA,YAAoC,QAAA,EAA9B,OAAM,gBAAA,GAAgB,GAAC;AAAA;sBAAQA,YAAyC,QAAA,EAAnC,OAAM,gBAAA,GAAgB,QAAM;AAAA,sCAAO,uCAAqC;AAAA,oBAAA;oBACxHA,YAA6G,OAAA,MAAA;AAAA,sBAAxGA,YAAoC,QAAA,EAA9B,OAAM,gBAAA,GAAgB,GAAC;AAAA;sBAAQA,YAAwC,QAAA,EAAlC,OAAM,gBAAA,GAAgB,OAAK;AAAA,sCAAO,uBAAqB;AAAA,oBAAA;;;gBAI3GA,YASM,OAAA,EATD,OAAM,4FAAwF;AAAA,kBACjGA,YAAwE,KAAA,EAArE,OAAM,8DAA4D;AAAA,kBACrEA,YAAyD,gBAAjD,0CAAwC;AAAA,kBAChDA,YAKK,MAAA,EALD,OAAM,8DAA0D;AAAA,oBAClEA,YAAwG,MAAA,MAAA;AAAA,sCAApG,qBAAmB;AAAA,sBAAAA,YAAmC,cAA7B,wBAAsB;AAAA,sCAAO,2CAAyC;AAAA,oBAAA;oBACnGA,YAAiG,MAAA,MAAA;AAAA,sCAA7F,2BAAyB;AAAA,sBAAAA,YAA4C,cAAtC,iCAA+B;AAAA,sCAAO,qBAAmB;AAAA,oBAAA;oBAC5FA,YAAoE,YAAhE,6DAA2D;AAAA,oBAC/DA,YAA8B,YAA1B,uBAAqB;AAAA,kBAAA;;;;;;;;kEASxBL,MAAA,SAAA,MAAS,YAAA,OAAA,EAAA,SAAA,OAAA,CAAA,CAAA,oBAAA;;QAElB,OAAM;AAAA,QACN,MAAK;AAAA,QACL,OAAM;AAAA,QACN,gBAAa;AAAA,QACb,cAAW;AAAA,QACV,gBAAc;AAAA,QACf,aAAY;AAAA,QACX,eAAa;AAAA,QACb,QAAM;AAAA,MAAA;;AAME,UAAAA,MAAA,KAAA,EAAM,MAAI;6BACRD,eAAA,CAAAC,MAAA,KAAA,EAAM,SAAI,YAAA,sCAAA,6BAAA,wHAAA,CAAA,gCAEVD,eAAAC,MAAA,KAAA,EAAM,SAAI,YAAA,8CAAA,6CAAA,2BAClBC,eAAAD,MAAA,KAAA,EAAM,GAAG;;;;;;;;;;;;;;;","names":["_ssrRenderClass","_unref","_ssrInterpolate","_ssrRenderList","_push","_parent","_createVNode"],"sources":["../../../../components/ImportPanel.vue","../../../../pages/import.vue"],"sourcesContent":["<template>\n  <div>\n    <!-- Header card -->\n    <div class=\"card mb-5\">\n      <div class=\"flex items-start justify-between gap-4 flex-wrap\">\n        <div>\n          <div class=\"flex items-center gap-2 mb-1\">\n            <div :class=\"`w-8 h-8 rounded-lg bg-${color}-900/40 flex items-center justify-center`\">\n              <i :class=\"`fa-solid ${icon} text-${color}-400 text-sm`\" />\n            </div>\n            <h3 class=\"font-semibold text-gray-100\">{{ label }}</h3>\n          </div>\n          <p class=\"text-sm text-gray-500\">{{ description }}</p>\n        </div>\n        <!-- Download template -->\n        <button @click=\"downloadTemplate\"\n                :disabled=\"downloading\"\n                class=\"btn-secondary btn-sm flex-shrink-0\">\n          <i :class=\"downloading ? 'fa-solid fa-circle-notch fa-spin' : 'fa-solid fa-download'\" />\n          Download Template CSV\n        </button>\n      </div>\n    </div>\n\n    <!-- Drop zone -->\n    <div class=\"card mb-5\">\n      <div class=\"section-title mb-4\"><i class=\"fa-solid fa-file-csv mr-1.5 text-primary-400\" />Pilih File CSV</div>\n\n      <div\n        @dragover.prevent=\"dragging = true\"\n        @dragleave.prevent=\"dragging = false\"\n        @drop.prevent=\"onDrop\"\n        :class=\"[\n          'border-2 border-dashed rounded-xl p-10 text-center transition-all cursor-pointer',\n          dragging\n            ? 'border-primary-400 bg-primary-900/20'\n            : file\n              ? 'border-emerald-600 bg-emerald-900/10'\n              : 'border-navy-600 hover:border-navy-500 hover:bg-navy-800/40',\n        ]\"\n        @click=\"fileInput?.click()\"\n      >\n        <input ref=\"fileInput\" type=\"file\" accept=\".csv,.txt\" class=\"hidden\" @change=\"onFileChange\" />\n        <div v-if=\"!file\">\n          <i class=\"fa-solid fa-cloud-arrow-up text-4xl text-gray-600 mb-3 block\" />\n          <p class=\"text-gray-400 font-medium\">Drag & drop file CSV ke sini</p>\n          <p class=\"text-gray-600 text-sm mt-1\">atau klik untuk memilih file</p>\n          <p class=\"text-gray-700 text-xs mt-2\">Format: .csv · Maks. 10MB</p>\n        </div>\n        <div v-else class=\"flex flex-col items-center gap-2\">\n          <i class=\"fa-solid fa-file-csv text-4xl text-emerald-400 mb-1\" />\n          <p class=\"text-emerald-300 font-semibold\">{{ file.name }}</p>\n          <p class=\"text-gray-500 text-sm\">{{ formatSize(file.size) }} · {{ previewRows.length }} baris data</p>\n          <button type=\"button\" @click.stop=\"clearFile\"\n                  class=\"mt-1 text-xs text-red-400 hover:text-red-300 flex items-center gap-1\">\n            <i class=\"fa-solid fa-xmark\" />Hapus file\n          </button>\n        </div>\n      </div>\n\n      <!-- Info slot -->\n      <slot name=\"info\" />\n\n      <!-- CSV Preview -->\n      <div v-if=\"previewRows.length\" class=\"mt-5\">\n        <div class=\"flex items-center justify-between mb-2\">\n          <p class=\"text-xs text-gray-500 font-medium uppercase tracking-wider\">\n            Preview ({{ previewRows.length > 5 ? '5 dari' : '' }} {{ previewRows.length }} baris)\n          </p>\n          <span class=\"text-xs text-gray-600\">{{ csvHeaders.length }} kolom</span>\n        </div>\n        <div class=\"overflow-x-auto rounded-lg border border-navy-700\">\n          <table class=\"w-full text-xs\">\n            <thead>\n              <tr class=\"bg-navy-800\">\n                <th v-for=\"col in previewCols\" :key=\"col.key\"\n                    class=\"px-3 py-2 text-left text-gray-400 font-medium whitespace-nowrap border-b border-navy-700\">\n                  {{ col.label }}\n                </th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr v-for=\"(row, i) in previewRows.slice(0,5)\" :key=\"i\"\n                  class=\"border-b border-navy-800/60 last:border-0 hover:bg-navy-800/30\">\n                <td v-for=\"col in previewCols\" :key=\"col.key\"\n                    class=\"px-3 py-1.5 text-gray-300 whitespace-nowrap max-w-32 truncate\">\n                  {{ row[col.key] || '—' }}\n                </td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n\n    <!-- Options + Upload -->\n    <div class=\"card mb-5\">\n      <div class=\"section-title mb-4\"><i class=\"fa-solid fa-sliders mr-1.5\" />Opsi Import</div>\n\n      <!-- Danger: clear first -->\n      <label class=\"flex items-start gap-3 p-4 rounded-xl border cursor-pointer transition-all mb-4\"\n             :class=\"clearFirst\n               ? 'border-red-700/70 bg-red-900/20'\n               : 'border-navy-700 hover:border-navy-600 bg-navy-800/30'\">\n        <input type=\"checkbox\" v-model=\"clearFirst\" class=\"mt-0.5 accent-red-500 w-4 h-4 flex-shrink-0\" />\n        <div>\n          <div class=\"text-sm font-medium\" :class=\"clearFirst ? 'text-red-300' : 'text-gray-300'\">\n            <i class=\"fa-solid fa-triangle-exclamation mr-1\" :class=\"clearFirst ? 'text-red-400' : 'text-gray-600'\" />\n            Hapus data existing sebelum import\n          </div>\n          <div class=\"text-xs text-gray-500 mt-0.5\">{{ dangerDesc }}</div>\n        </div>\n      </label>\n\n      <!-- Confirm clear -->\n      <Transition name=\"slide\">\n        <div v-if=\"clearFirst\"\n             class=\"flex items-center gap-3 bg-red-900/30 border border-red-700/50 rounded-xl px-4 py-3 mb-4\">\n          <i class=\"fa-solid fa-skull-crossbones text-red-400 text-lg flex-shrink-0\" />\n          <div class=\"flex-1 text-xs text-red-300\">\n            Semua data yang ada akan <strong>dihapus permanen</strong> sebelum import dimulai.\n            Pastikan Anda sudah melakukan backup.\n          </div>\n          <label class=\"flex items-center gap-2 flex-shrink-0 cursor-pointer\">\n            <input type=\"checkbox\" v-model=\"confirmClear\" class=\"accent-red-500 w-4 h-4\" />\n            <span class=\"text-xs text-red-300 font-medium\">Saya mengerti</span>\n          </label>\n        </div>\n      </Transition>\n\n      <!-- Upload button -->\n      <div class=\"flex items-center gap-3\">\n        <button @click=\"doUpload\"\n                :disabled=\"!canUpload\"\n                class=\"btn-primary disabled:opacity-40 disabled:cursor-not-allowed\">\n          <i :class=\"uploading ? 'fa-solid fa-circle-notch fa-spin' : 'fa-solid fa-file-arrow-up'\" />\n          {{ uploading ? 'Mengupload...' : 'Mulai Import' }}\n        </button>\n        <span v-if=\"!file\" class=\"text-xs text-gray-600\">Pilih file CSV terlebih dahulu</span>\n        <span v-else-if=\"clearFirst && !confirmClear\" class=\"text-xs text-red-500\">\n          Centang konfirmasi untuk melanjutkan\n        </span>\n      </div>\n    </div>\n\n    <!-- Result -->\n    <Transition name=\"slide\">\n      <div v-if=\"result\" class=\"card\">\n        <div class=\"section-title mb-4\">\n          <i class=\"fa-solid fa-clipboard-check mr-1.5 text-emerald-400\" />Hasil Import\n        </div>\n\n        <div class=\"grid grid-cols-3 gap-3 mb-4\">\n          <div class=\"bg-emerald-900/30 border border-emerald-700/50 rounded-xl p-4 text-center\">\n            <div class=\"text-3xl font-bold text-emerald-400\">{{ result.imported }}</div>\n            <div class=\"text-xs text-emerald-600 mt-0.5\">Baris Baru</div>\n          </div>\n          <div class=\"bg-blue-900/30 border border-blue-700/50 rounded-xl p-4 text-center\">\n            <div class=\"text-3xl font-bold text-blue-400\">{{ result.updated }}</div>\n            <div class=\"text-xs text-blue-600 mt-0.5\">Diperbarui</div>\n          </div>\n          <div class=\"bg-red-900/20 border border-red-700/30 rounded-xl p-4 text-center\">\n            <div class=\"text-3xl font-bold\" :class=\"result.skipped > 0 ? 'text-red-400' : 'text-gray-600'\">{{ result.skipped }}</div>\n            <div class=\"text-xs text-red-600 mt-0.5\">Dilewati</div>\n          </div>\n        </div>\n\n        <!-- Sync info (untuk import invoice) -->\n        <div v-if=\"result.synced_months != null\"\n             class=\"flex items-center gap-4 bg-emerald-900/20 border border-emerald-700/40 rounded-xl px-4 py-3 mb-4 text-xs text-emerald-300\">\n          <i class=\"fa-solid fa-rotate text-emerald-400 text-lg flex-shrink-0\" />\n          <div>\n            <div class=\"font-medium\">Revenue Tracker berhasil diperbarui</div>\n            <div class=\"text-emerald-400/70 mt-0.5\">\n              {{ result.synced_months }} termin bulanan &amp; {{ result.synced_projects }} project di-recalculate\n            </div>\n          </div>\n        </div>\n\n        <!-- Errors -->\n        <div v-if=\"result.errors?.length\" class=\"space-y-1\">\n          <div class=\"text-xs text-gray-500 font-medium uppercase tracking-wider mb-2\">\n            Detail Error ({{ result.errors.length }}):\n          </div>\n          <div v-for=\"err in result.errors\" :key=\"err\"\n               class=\"flex items-start gap-2 text-xs text-red-300 bg-red-900/20 border border-red-900/40 rounded px-3 py-1.5\">\n            <i class=\"fa-solid fa-circle-exclamation text-red-500 mt-0.5 flex-shrink-0\" />\n            {{ err }}\n          </div>\n        </div>\n        <div v-else class=\"flex items-center gap-2 text-sm text-emerald-400\">\n          <i class=\"fa-solid fa-circle-check\" />\n          Import selesai tanpa error.\n        </div>\n      </div>\n    </Transition>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\ninterface Col { key: string; label: string }\n\nconst props = defineProps<{\n  label:        string\n  icon:         string\n  color:        string\n  templateUrl:  string\n  uploadUrl:    string\n  previewCols:  Col[]\n  description:  string\n  dangerDesc:   string\n}>()\n\nconst emit = defineEmits<{\n  (e: 'done', msg: string, type: 'success' | 'error'): void\n}>()\n\nconst { getBlob, postForm } = useApi()\n\nconst fileInput   = ref<HTMLInputElement | null>(null)\nconst dragging    = ref(false)\nconst downloading = ref(false)\nconst uploading   = ref(false)\nconst clearFirst  = ref(false)\nconst confirmClear = ref(false)\nconst file         = ref<File | null>(null)\nconst csvHeaders   = ref<string[]>([])\nconst previewRows  = ref<Record<string, string>[]>([])\nconst result       = ref<{ imported: number; updated: number; skipped: number; errors: string[] } | null>(null)\n\nconst canUpload = computed(() =>\n  !!file.value && !uploading.value && (!clearFirst.value || confirmClear.value)\n)\n\n// ── File handling ──────────────────────────────────────────────────────\nfunction onDrop(e: DragEvent) {\n  dragging.value = false\n  const f = e.dataTransfer?.files?.[0]\n  if (f) loadFile(f)\n}\n\nfunction onFileChange(e: Event) {\n  const f = (e.target as HTMLInputElement).files?.[0]\n  if (f) loadFile(f)\n}\n\nfunction clearFile() {\n  file.value      = null\n  csvHeaders.value = []\n  previewRows.value = []\n  result.value    = null\n  if (fileInput.value) fileInput.value.value = ''\n}\n\nfunction loadFile(f: File) {\n  file.value   = f\n  result.value = null\n  parseCSVPreview(f)\n}\n\nfunction parseCSVPreview(f: File) {\n  const reader = new FileReader()\n  reader.onload = (e) => {\n    const text    = (e.target?.result as string) || ''\n    // Strip UTF-8 BOM (berbagai encoding)\n    const cleaned = text.replace(/^﻿/, '')\n    // Handle semua jenis line ending: \\r\\n (Windows), \\r (old Mac), \\n (Unix)\n    const allLines = cleaned.split(/\\r\\n|\\r|\\n/)\n    const lines    = allLines.filter(l => l.trim() !== '')\n    if (!lines.length) return\n\n    // Deteksi separator: coba titik koma dulu (Excel ID), lalu koma\n    const firstLine = lines[0]\n    const sep = firstLine.includes(';') && !firstLine.includes(',') ? ';' : ','\n\n    const parseRow = (line: string): string[] => {\n      const cols: string[] = []\n      let cur = '', inQ = false\n      for (let i = 0; i < line.length; i++) {\n        const c = line[i]\n        if (c === '\"' && !inQ)  { inQ = true;  continue }\n        if (c === '\"' && inQ)   { inQ = false; continue }\n        if (c === sep && !inQ)  { cols.push(cur.trim()); cur = ''; continue }\n        cur += c\n      }\n      cols.push(cur.trim())\n      return cols\n    }\n\n    const headers  = parseRow(lines[0])\n    csvHeaders.value = headers\n\n    // Ambil baris data: skip baris komentar (#) dan header\n    const dataLines = lines.slice(1).filter(l => !l.trimStart().startsWith('#'))\n    previewRows.value = dataLines.slice(0, 5).map(line => {\n      const cols = parseRow(line)\n      const row: Record<string, string> = {}\n      headers.forEach((h, i) => { row[h] = cols[i] ?? '' })\n      return row\n    })\n  }\n  reader.readAsText(f, 'UTF-8')\n}\n\n// ── Download template ──────────────────────────────────────────────────\nasync function downloadTemplate() {\n  downloading.value = true\n  try {\n    const blob = await getBlob(props.templateUrl)\n    const url  = URL.createObjectURL(blob)\n    const a    = document.createElement('a')\n    a.href     = url\n    const name = props.templateUrl.split('/').pop() || 'template'\n    a.download = name.includes('.csv') ? name : name + '.csv'\n    a.click()\n    URL.revokeObjectURL(url)\n  } catch {\n    emit('done', 'Gagal mengunduh template.', 'error')\n  } finally {\n    downloading.value = false\n  }\n}\n\n// ── Upload ─────────────────────────────────────────────────────────────\nasync function doUpload() {\n  if (!file.value) return\n  uploading.value = true\n  result.value    = null\n  try {\n    const form = new FormData()\n    form.append('file', file.value)\n    form.append('clear_first', clearFirst.value ? '1' : '0')\n\n    const res = await postForm(props.uploadUrl, form)\n    result.value = res\n\n    const total = (res.imported ?? 0) + (res.updated ?? 0)\n    emit('done',\n      `Import selesai: ${res.imported} baru, ${res.updated} diperbarui, ${res.skipped} dilewati.`,\n      res.skipped > 0 && total === 0 ? 'error' : 'success'\n    )\n  } catch (err: any) {\n    const msg = err?.data?.message || err?.message || 'Import gagal.'\n    emit('done', msg, 'error')\n  } finally {\n    uploading.value = false\n  }\n}\n\nfunction formatSize(bytes: number): string {\n  if (bytes < 1024) return bytes + ' B'\n  if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB'\n  return (bytes / 1048576).toFixed(1) + ' MB'\n}\n</script>\n\n<style scoped>\n.slide-enter-active, .slide-leave-active { transition: all .3s ease; }\n.slide-enter-from, .slide-leave-to { opacity: 0; transform: translateY(-8px); }\n</style>\n","<template>\n  <div>\n    <div class=\"page-header mb-6\">\n      <div>\n        <h1 class=\"page-title\"><i class=\"fa-solid fa-file-arrow-up text-primary-400 mr-2\" />Upload Data</h1>\n        <p class=\"page-subtitle\">Import data Pipeline dan Revenue dari file CSV</p>\n      </div>\n    </div>\n\n    <!-- Tabs -->\n    <div class=\"flex gap-1 mb-6 bg-navy-900 rounded-xl p-1 w-fit border border-navy-700\">\n      <button v-for=\"tab in tabs\" :key=\"tab.key\"\n              @click=\"activeTab = tab.key\"\n              :class=\"activeTab === tab.key\n                ? 'bg-primary-600 text-white shadow-lg'\n                : 'text-gray-400 hover:text-gray-200'\"\n              class=\"px-5 py-2 rounded-lg text-sm font-medium transition-all\">\n        <i :class=\"`fa-solid ${tab.icon} mr-1.5`\" />{{ tab.label }}\n      </button>\n    </div>\n\n    <!-- Info alur invoice -->\n    <Transition name=\"toast\">\n      <div v-if=\"activeTab === 'invoice'\"\n           class=\"flex items-start gap-3 bg-emerald-900/20 border border-emerald-700/40 rounded-xl px-4 py-3 mb-5 text-sm text-emerald-300\">\n        <i class=\"fa-solid fa-circle-info text-emerald-400 mt-0.5 flex-shrink-0\" />\n        <div>\n          <strong>Upload Invoice & Payment</strong> akan otomatis memperbarui nilai\n          <span class=\"font-mono text-emerald-200\">actual</span> pada Revenue Tracker.\n          <span class=\"text-emerald-400/70 text-xs block mt-0.5\">\n            Alur: CSV → upsert tabel invoices → recalculate realisasi bulanan per project → update status & achievement project\n          </span>\n        </div>\n      </div>\n    </Transition>\n\n    <!-- ── PIPELINE TAB ─────────────────────────────────────────────── -->\n    <div v-show=\"activeTab === 'pipeline'\" class=\"space-y-5\">\n      <ImportPanel\n        label=\"Pipeline / Leads\"\n        icon=\"fa-funnel-dollar\"\n        color=\"primary\"\n        template-url=\"/v1/import/template/pipeline\"\n        upload-url=\"/v1/import/pipeline\"\n        :preview-cols=\"pipelineCols\"\n        description=\"Data leads pipeline: nama company, stage, prioritas, propose value, dst.\"\n        :danger-desc=\"`Hapus SEMUA leads, follow-up log, dan kontak sebelum import. Data tidak bisa dikembalikan.`\"\n        @done=\"handleDone\"\n      >\n        <template #info>\n          <div class=\"mt-4 p-3 bg-blue-900/20 border border-blue-700/40 rounded-xl text-xs text-blue-300\">\n            <i class=\"fa-solid fa-circle-info mr-1.5 text-blue-400\" />\n            <strong>Kolom <code class=\"bg-blue-900/40 px-1 rounded\">probability</code> bisa dikosongkan</strong>\n            — sistem akan mengisi otomatis berdasarkan Stage:\n            <div class=\"mt-2 flex flex-wrap gap-x-4 gap-y-1 text-blue-400/80 font-mono\">\n              <span>New → <strong class=\"text-white\">10%</strong></span>\n              <span>In Progress → <strong class=\"text-white\">25%</strong></span>\n              <span>Demo Scheduled → <strong class=\"text-white\">40%</strong></span>\n              <span>Proposal Sent → <strong class=\"text-white\">60%</strong></span>\n              <span>Negotiation → <strong class=\"text-white\">80%</strong></span>\n              <span>Won → <strong class=\"text-white\">100%</strong></span>\n              <span>On Hold → <strong class=\"text-white\">20%</strong></span>\n              <span>Lost → <strong class=\"text-white\">0%</strong></span>\n            </div>\n          </div>\n        </template>\n      </ImportPanel>\n    </div>\n\n    <!-- ── INVOICE TAB ─────────────────────────────────────────────── -->\n    <div v-show=\"activeTab === 'invoice'\" class=\"space-y-5\">\n      <ImportPanel\n        label=\"Invoice & Payment\"\n        icon=\"fa-file-invoice-dollar\"\n        color=\"emerald\"\n        template-url=\"/v1/import/template/invoice\"\n        upload-url=\"/v1/import/invoice\"\n        :preview-cols=\"invoiceCols\"\n        description=\"Upload data invoice dan pembayaran. Realisasi revenue bulanan akan otomatis diperbarui.\"\n        :danger-desc=\"`Hapus SEMUA data invoice sebelum import. Revenue aktual tetap aman — akan di-recalculate ulang dari data baru.`\"\n        @done=\"handleDone\"\n      >\n        <template #info>\n          <div class=\"mt-4 space-y-2\">\n            <!-- Kolom wajib -->\n            <div class=\"p-3 bg-navy-800/60 border border-navy-700 rounded-xl text-xs text-gray-400\">\n              <div class=\"font-medium text-gray-300 mb-1.5\">\n                <i class=\"fa-solid fa-table-columns mr-1 text-primary-400\" />Kolom CSV\n              </div>\n              <div class=\"grid grid-cols-2 gap-x-6 gap-y-1\">\n                <div><span class=\"text-red-400\">*</span> <code class=\"text-primary-300\">invoice_no</code> — nomor invoice (unik, wajib)</div>\n                <div><span class=\"text-red-400\">*</span> <code class=\"text-primary-300\">project_id</code> — harus cocok dengan revenue project</div>\n                <div><span class=\"text-red-400\">*</span> <code class=\"text-primary-300\">invoice_date</code> — format YYYY-MM-DD</div>\n                <div><span class=\"text-red-400\">*</span> <code class=\"text-primary-300\">invoice_amount</code> — nilai invoice (Rp)</div>\n                <div><span class=\"text-gray-500\">○</span> <code class=\"text-gray-400\">paid_amount</code> — nilai terbayar (default 0)</div>\n                <div><span class=\"text-gray-500\">○</span> <code class=\"text-gray-400\">paid_date</code> — tanggal bayar (opsional)</div>\n                <div><span class=\"text-gray-500\">○</span> <code class=\"text-gray-400\">status</code> — otomatis: Lunas / Partial / Unpaid</div>\n                <div><span class=\"text-gray-500\">○</span> <code class=\"text-gray-400\">notes</code> — catatan (opsional)</div>\n              </div>\n            </div>\n            <!-- Alur update -->\n            <div class=\"p-3 bg-emerald-900/20 border border-emerald-700/40 rounded-xl text-xs text-emerald-300\">\n              <i class=\"fa-solid fa-arrow-right-arrow-left mr-1.5 text-emerald-400\" />\n              <strong>Yang otomatis diperbarui setelah upload:</strong>\n              <ol class=\"mt-1.5 ml-4 list-decimal space-y-0.5 text-emerald-400/80\">\n                <li>Realisasi bulanan (<code>revenue_monthly.actual</code>) = SUM paid_amount per project per bulan</li>\n                <li>Total realisasi project (<code>revenue_projects.actual_revenue</code>) = SUM semua bulan</li>\n                <li>Status & Risk Level project (On Track / At Risk / Critical)</li>\n                <li>Achievement % project</li>\n              </ol>\n            </div>\n          </div>\n        </template>\n      </ImportPanel>\n    </div>\n\n    <!-- ── REVENUE TAB ──────────────────────────────────────────────── -->\n    <div v-show=\"activeTab === 'revenue'\" class=\"space-y-5\">\n      <ImportPanel\n        label=\"Revenue Projects\"\n        icon=\"fa-chart-line\"\n        color=\"emerald\"\n        template-url=\"/v1/import/template/revenue\"\n        upload-url=\"/v1/import/revenue\"\n        :preview-cols=\"revenueCols\"\n        description=\"Data revenue project beserta target & aktual per bulan (Jan–Des).\"\n        :danger-desc=\"`Hapus SEMUA data revenue_projects dan revenue_monthly sebelum import.`\"\n        @done=\"handleDone\"\n      />\n    </div>\n\n    <!-- Global result toast -->\n    <Transition name=\"toast\">\n      <div v-if=\"toast.show\"\n           :class=\"toast.type === 'success' ? 'bg-emerald-900 border-emerald-600' : 'bg-red-900 border-red-700'\"\n           class=\"fixed bottom-6 right-6 z-50 flex items-center gap-3 px-4 py-3 rounded-xl border shadow-2xl text-sm text-white max-w-sm\">\n        <i :class=\"toast.type === 'success' ? 'fa-solid fa-circle-check text-emerald-400' : 'fa-solid fa-circle-exclamation text-red-400'\" />\n        {{ toast.msg }}\n      </div>\n    </Transition>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\ndefinePageMeta({ middleware: 'auth' })\n\nconst activeTab = ref<'pipeline'|'revenue'>('pipeline')\n\nconst tabs = [\n  { key: 'pipeline', label: 'Pipeline',         icon: 'fa-funnel-dollar'        },\n  { key: 'invoice',  label: 'Invoice & Payment', icon: 'fa-file-invoice-dollar' },\n  { key: 'revenue',  label: 'Revenue Projects',  icon: 'fa-chart-line'          },\n]\n\nconst pipelineCols = [\n  { key: 'lead_id',        label: 'Lead ID'       },\n  { key: 'nama_company',   label: 'Company'       },\n  { key: 'stage',          label: 'Stage'         },\n  { key: 'prioritas',      label: 'Prioritas'     },\n  { key: 'propose_value',  label: 'Propose Value' },\n  { key: 'sales_owner',    label: 'Sales'         },\n  { key: 'organisasi',     label: 'Organisasi'    },\n  { key: 'exp_close_date', label: 'Exp. Close'    },\n]\n\nconst invoiceCols = [\n  { key: 'invoice_no',     label: 'No. Invoice'   },\n  { key: 'project_id',     label: 'Project ID'    },\n  { key: 'invoice_date',   label: 'Tgl Invoice'   },\n  { key: 'invoice_amount', label: 'Nilai Invoice'  },\n  { key: 'paid_amount',    label: 'Terbayar'       },\n  { key: 'paid_date',      label: 'Tgl Bayar'      },\n  { key: 'status',         label: 'Status'         },\n  { key: 'notes',          label: 'Catatan'        },\n]\n\nconst revenueCols = [\n  { key: 'project_id',  label: 'Project ID'   },\n  { key: 'client',      label: 'Client'       },\n  { key: 'product',     label: 'Product'      },\n  { key: 'organisasi',  label: 'Organisasi'   },\n  { key: 'type',        label: 'Type'         },\n  { key: 'tahun',       label: 'Tahun'        },\n  { key: 'target_1',    label: 'Target Jan'   },\n  { key: 'actual_1',    label: 'Aktual Jan'   },\n]\n\nconst toast = reactive({ show: false, msg: '', type: 'success' as 'success' | 'error' })\n\nfunction handleDone(msg: string, type: 'success' | 'error') {\n  toast.msg  = msg\n  toast.type = type\n  toast.show = true\n  setTimeout(() => { toast.show = false }, 4000)\n}\n</script>\n\n<style scoped>\n.toast-enter-active, .toast-leave-active { transition: all .3s ease; }\n.toast-enter-from, .toast-leave-to { opacity: 0; transform: translateY(8px); }\n</style>\n"],"version":3}