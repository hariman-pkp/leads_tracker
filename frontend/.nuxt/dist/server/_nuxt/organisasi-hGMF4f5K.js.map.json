{"file":"organisasi-hGMF4f5K.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;AAwCA,UAAM,QAAQ;AAMd,UAAM,WAAW;AAAA,MAAS,MACxB,MAAM,IAAI,OAAO,CAAC,MAAW,EAAE,cAAc,MAAM,KAAK,EAAE;AAAA,IAAA;;;kLA3C1B,QAAA,QAAK,KAAA,CAAA,IAAA;UAErB,QAAA,QAAK,GAAA;gFACZ,QAAA,QAAK,IAAA,OAAA,IAAA,CAAA,SAAA;AAAA;;;;;QAGyDA,MAAA,QAAA,EAAS,SAAM,gCAAA;AAAA,MAAA,8FAM7EC,eAAA,QAAA,KAAK,IAAI,mDAG6BA,eAAA,QAAA,KAAK,IAAI;AAExC,UAAA,QAAA,KAAK,MAAI;AAC8B,cAAA,oHAAAA,eAAA,QAAA,KAAK,IAAI,CAAA,SAAA;AAAA;;;AAG/C,UAAA,CAAA,QAAA,KAAK,WAAS;;;;;;AAMXC,oBAAAF,MAAA,QAAA,IAAT,UAAK;;UACX,KAAK,MAAM;AAAA,UACX,MAAM;AAAA,UACN,KAAK,QAAA;AAAA,UACL,OAAO,QAAA,QAAK;AAAA,QAAA;;;;;;;;;;;;;;;;ACiOa,WAAA;AAGhC,UAAM,UAAU,IAAI,IAAI;AACxB,UAAM,SAAU,IAAI,KAAK;AACzB,UAAM,OAAU,IAAW,EAAE;AAC7B,UAAM,QAAU,IAAW,EAAE;AAE7B,UAAM,QAAU,SAAS,EAAE,MAAM,OAAO,MAAM,WAAW,KAAK,IAAI;AAClE,UAAM,QAAU,SAAS;AAAA,MACvB,MAAM;AAAA,MAAO,OAAO;AAAA,MAAO,OAAO;AAAA,MAClC,MAAM,EAAE,MAAM,IAAI,MAAM,IAAI,WAAW,MAAuB,MAAM,IAAI,WAAW,EAAA;AAAA,IAAE,CACtF;AACD,UAAM,WAAW,SAAS,EAAE,MAAM,OAAO,KAAK,MAAa,OAAO,IAAI;AAkBtE,UAAM,WAAW,SAAS,MAAM,KAAK,MAAM,OAAO,CAAC,MAAW,CAAC,EAAE,SAAS,CAAC;AAG3E,UAAM,gBAAgB;AAAA,MAAS,MAC7B,KAAK,MAAM,OAAO,CAAC,MAAW,EAAE,OAAO,MAAM,KAAK,IAAI,CAAC;AAAA,IAAA;AAGzD,aAAS,YAAY,IAAqB;AACxC,aAAO,KAAK,MAAM,KAAK,CAAC,MAAW,EAAE,cAAc,EAAE;AAAA,IACvD;;;mBA3SOG,eAAAC,WAAA,EAAA,OAAM,eAAW,MAAA,CAAA,mKAOYH,eAAAD,MAAA,IAAA,EAAK,MAAM;AAS9B,UAAAA,MAAA,KAAA,EAAM,MAAI;6BACRK,eAAA,CAAAL,MAAA,KAAA,EAAM,SAAI,gNAKVK,eAAAL,MAAA,KAAA,EAAM,SAAI,gHAGlBC,eAAAD,MAAA,KAAA,EAAM,GAAG;;;;UAKLA,MAAA,OAAA,GAAO;;;;AAkBF,YAAAA,MAAA,IAAA,EAAK,WAAM,GAAA;;;;;;AAMHE,sBAAAF,MAAA,IAAA,IAAP,QAAG;AAKL,gBAAA,uLAAAC,eAAA,IAAI,IAAI,CAAA,yEAAA;cAMF,YAAY,IAAI,EAAE,GAAA;;;;;AAGgB,gBAAA,2CAAAA,eAAA,IAAI,IAAI,CAAA,0CAAA;AAKzC,cAAA,IAAI,aAAW;iMAGmBA,eAAA,IAAI,WAAW,uCAC5BA,eAAA,IAAI,WAAW;;;;;AAMpC,cAAA,IAAI,MAAI;AAEf,kBAAA,sGAAAA,eAAA,IAAI,IAAI,CAAA,SAAA;AAAA;;;uEAMCI,eAAA,IAAI,YAAS,kBAAA,YAAA,MACtBJ,eAAA,IAAI,YAAS,UAAA,WAAA,uMAYTK,cAAA,SAAO,YAAY,IAAI,EAAE,IAAA,kDAAA,OAAA,4BAClB,YAAY,IAAI,EAAE,IAAA,kCAAA,IAAA,mDAAA,CAAA;;;;WAUhCN,MAAA,OAAA,KAAWA,MAAA,IAAA,EAAK,SAAM,GAAA;;AAMbE,sBAAAF,MAAA,QAAA,IAAR,SAAI;;YACV,KAAK,KAAK;AAAA,YACV,MAAM;AAAA,YACN,KAAKA,MAAA,IAAA;AAAA,YACL,OAAO;AAAA,UAAA;;;;;;AAKH,UAAAA,MAAA,KAAA,EAAM,MAAI;6XAMVC,eAAAD,MAAA,KAAA,EAAM,QAAK,sBAAA,iBAAA,mQAaEA,MAAA,KAAA,EAAM,KAAK,IAAI,0SAYfA,MAAA,KAAA,EAAM,KAAK,IAAI,gKASpBM,cAAA,SAAO,IAAI,wCADLN,MAAA,KAAA,EAAM,KAAK,SAAS,IAApBO,gBAAAP,MAAA,KAAA,EAAM,KAAK,WACV,IAAI,IADLQ,cAAAR,MAAA,KAAA,EAAM,KAAK,WACV,IAAI,CAAA,IAAA,cAAA;AAEJE,sBAAAF,MAAA,aAAA,IAAP,QAAG;wCAET,SAAO,IAAI,EAAE,wCALDA,MAAA,KAAA,EAAM,KAAK,SAAS,IAApBO,gBAAAP,MAAA,KAAA,EAAM,KAAK,WAKhB,IAAI,EAAE,IALDQ,cAAAR,MAAA,KAAA,EAAM,KAAK,WAKhB,IAAI,EAAE,CAAA,IAAA,cAAA,MACXC,eAAA,IAAI,IAAI,OAASA,eAAA,IAAI,IAAI;;oIAQhBD,MAAA,KAAA,EAAM,KAAK,IAAI,CAAA,+GAAA;AAKTE,sBAAAF,MAAA,KAAA,IAAL,MAAC;wCAAwB,SAAO,EAAE,IAAI,CAAA,YAAA;AAAA;;AAK7C,YAAA,CAAAA,MAAA,KAAA,EAAM,OAAK;mGAGVM,cAAA,SAAO,CAAC,wCADFN,MAAA,KAAA,EAAM,KAAK,SAAS,IAApBO,gBAAAP,MAAA,KAAA,EAAM,KAAK,WACV,CAAC,IADFQ,cAAAR,MAAA,KAAA,EAAM,KAAK,WACV,CAAC,CAAA,IAAA,cAAA,2BACRM,cAAA,SAAO,CAAC,wCAFFN,MAAA,KAAA,EAAM,KAAK,SAAS,IAApBO,gBAAAP,MAAA,KAAA,EAAM,KAAK,WAEV,CAAC,IAFFQ,cAAAR,MAAA,KAAA,EAAM,KAAK,WAEV,CAAC,CAAA,IAAA,cAAA;;;;AAKV,YAAAA,MAAA,KAAA,EAAM,OAAK;AAIjB,gBAAA,0KAAAC,eAAAD,MAAA,KAAA,EAAM,KAAK,CAAA,QAAA;AAAA;;;6JAMiBA,MAAA,MAAA,CAAM,IAAA,cAAA,mDAC1BA,MAAA,MAAA,IAAM,qCAAA,yBAAA,WACdC,eAAAD,MAAA,KAAA,EAAM,QAAK,WAAA,QAAA;;;;AAOX,UAAAA,MAAA,QAAA,EAAS,MAAI;giBAUkBA,MAAA,QAAA,EAAS,KAAK,IAAI,qHAGPA,MAAA,QAAA,EAAS,KAAK,IAAI;AAExD,YAAAA,MAAA,QAAA,EAAS,OAAK;AAIpB,gBAAA,+KAAAC,eAAAD,MAAA,QAAA,EAAS,KAAK,CAAA,QAAA;AAAA;;;0HAIoBA,MAAA,MAAA,CAAM,IAAA,cAAA,EAAA,6GAAA;YAGhCA,MAAA,MAAA,GAAM;;;;;;;;;;;;;;;;;;;","names":["_unref","_ssrInterpolate","_ssrRenderList","_ssrRenderAttrs","_mergeProps","_ssrRenderClass","_ssrRenderAttr","_ssrLooseContain","_ssrLooseEqual"],"sources":["../../../../components/OrgTreeNode.vue","../../../../pages/master/organisasi.vue"],"sourcesContent":["<template>\n  <div>\n    <!-- Node -->\n    <div class=\"flex items-center gap-2 py-1 rounded hover:bg-navy-800/40 px-2 transition-colors\"\n         :style=\"`padding-left: ${depth * 20 + 8}px`\">\n      <!-- Garis hierarki -->\n      <span v-if=\"depth > 0\" class=\"text-gray-600 text-xs select-none\">\n        {{ depth > 1 ? '└─' : '└─' }}\n      </span>\n      <!-- Icon -->\n      <i :class=\"[\n        'fa-solid text-xs w-3.5 text-center',\n        children.length ? 'fa-sitemap text-primary-500' : 'fa-circle-dot text-gray-600'\n      ]\" />\n      <!-- Kode -->\n      <span class=\"font-mono text-xs text-primary-300 bg-navy-800 px-1.5 py-0.5 rounded\">\n        {{ node.kode }}\n      </span>\n      <!-- Nama -->\n      <span class=\"text-gray-200 font-medium\">{{ node.nama }}</span>\n      <!-- Head -->\n      <span v-if=\"node.head\" class=\"text-xs text-gray-500 flex items-center gap-1 ml-1\">\n        <i class=\"fa-solid fa-user-tie text-[10px]\" />{{ node.head }}\n      </span>\n      <!-- Status -->\n      <span v-if=\"!node.is_active\"\n            class=\"text-[10px] text-gray-500 border border-gray-700 rounded px-1\">non-aktif</span>\n    </div>\n\n    <!-- Rekursif untuk anak -->\n    <OrgTreeNode\n      v-for=\"child in children\"\n      :key=\"child.id\"\n      :node=\"child\"\n      :all=\"all\"\n      :depth=\"depth + 1\" />\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nconst props = defineProps<{\n  node:  any\n  all:   any[]\n  depth: number\n}>()\n\nconst children = computed(() =>\n  props.all.filter((o: any) => o.parent_id === props.node.id)\n)\n</script>\n","<template>\n  <div class=\"max-w-5xl\">\n    <!-- Header -->\n    <div class=\"page-header\">\n      <div>\n        <h1 class=\"page-title\">\n          <i class=\"fa-solid fa-sitemap text-primary-400 mr-2\" />Master Organisasi\n        </h1>\n        <p class=\"page-subtitle\">{{ list.length }} organisasi terdaftar</p>\n      </div>\n      <button @click=\"openAdd\" class=\"btn-primary\">\n        <i class=\"fa-solid fa-plus\" /> Tambah Organisasi\n      </button>\n    </div>\n\n    <!-- Toast -->\n    <Transition name=\"toast\">\n      <div v-if=\"toast.show\"\n           :class=\"toast.type === 'success'\n             ? 'bg-green-800 border-green-600'\n             : 'bg-red-900 border-red-600'\"\n           class=\"fixed top-5 right-5 z-50 flex items-center gap-3 px-4 py-3\n                  rounded-lg border shadow-xl text-sm text-white max-w-sm\">\n        <i :class=\"toast.type === 'success'\n          ? 'fa-solid fa-circle-check text-green-400'\n          : 'fa-solid fa-circle-exclamation text-red-400'\" />\n        {{ toast.msg }}\n      </div>\n    </Transition>\n\n    <!-- Loading -->\n    <div v-if=\"loading\" class=\"flex justify-center py-20\">\n      <i class=\"fa-solid fa-circle-notch fa-spin text-3xl text-primary-400\" />\n    </div>\n\n    <!-- Tabel -->\n    <div v-else class=\"card overflow-x-auto\">\n      <table class=\"w-full text-sm\">\n        <thead>\n          <tr class=\"border-b border-navy-700\">\n            <th class=\"text-left py-3 px-4 text-gray-400 font-medium w-32\">Kode</th>\n            <th class=\"text-left py-3 px-4 text-gray-400 font-medium\">Nama Organisasi</th>\n            <th class=\"text-left py-3 px-4 text-gray-400 font-medium\">Parent Organisasi</th>\n            <th class=\"text-left py-3 px-4 text-gray-400 font-medium\">Head</th>\n            <th class=\"text-center py-3 px-4 text-gray-400 font-medium w-24\">Status</th>\n            <th class=\"text-center py-3 px-4 text-gray-400 font-medium w-24\">Aksi</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr v-if=\"list.length === 0\">\n            <td colspan=\"6\" class=\"text-center py-16 text-gray-500\">\n              <i class=\"fa-solid fa-sitemap text-4xl block mb-3 opacity-30\" />\n              Belum ada data organisasi\n            </td>\n          </tr>\n          <tr v-for=\"org in list\" :key=\"org.id\"\n              class=\"border-b border-navy-800/50 hover:bg-navy-800/30 transition-colors\">\n            <!-- Kode -->\n            <td class=\"py-3 px-4\">\n              <span class=\"font-mono text-xs bg-navy-800 text-primary-300 px-2 py-1 rounded\">\n                {{ org.kode }}\n              </span>\n            </td>\n            <!-- Nama + indikator hirarki -->\n            <td class=\"py-3 px-4\">\n              <div class=\"flex items-center gap-2\">\n                <i v-if=\"hasChildren(org.id)\"\n                   class=\"fa-solid fa-sitemap text-xs text-gray-500\"\n                   title=\"Memiliki sub-organisasi\" />\n                <span class=\"font-medium text-gray-100\">{{ org.nama }}</span>\n              </div>\n            </td>\n            <!-- Parent -->\n            <td class=\"py-3 px-4\">\n              <span v-if=\"org.parent_kode\"\n                    class=\"inline-flex items-center gap-1.5 text-gray-300 text-xs\">\n                <i class=\"fa-solid fa-arrow-up text-[10px] text-gray-500\" />\n                <span class=\"font-mono text-primary-400\">{{ org.parent_kode }}</span>\n                <span class=\"text-gray-400\">{{ org.parent_nama }}</span>\n              </span>\n              <span v-else class=\"text-gray-600 text-xs\">— (Root)</span>\n            </td>\n            <!-- Head -->\n            <td class=\"py-3 px-4 text-gray-300\">\n              <span v-if=\"org.head\" class=\"flex items-center gap-1.5\">\n                <i class=\"fa-solid fa-user-tie text-xs text-gray-500\" />\n                {{ org.head }}\n              </span>\n              <span v-else class=\"text-gray-600 text-xs\">—</span>\n            </td>\n            <!-- Status -->\n            <td class=\"py-3 px-4 text-center\">\n              <span :class=\"org.is_active ? 'badge-emerald' : 'badge-gray'\">\n                {{ org.is_active ? 'Aktif' : 'Non-aktif' }}\n              </span>\n            </td>\n            <!-- Aksi -->\n            <td class=\"py-3 px-4 text-center\">\n              <button @click=\"openEdit(org)\"\n                      class=\"text-primary-400 hover:text-primary-300 transition-colors mr-3\"\n                      title=\"Edit\">\n                <i class=\"fa-solid fa-pen-to-square\" />\n              </button>\n              <button @click=\"confirmDelete(org)\"\n                      class=\"text-red-400 hover:text-red-300 transition-colors\"\n                      :title=\"hasChildren(org.id) ? 'Tidak dapat dihapus — memiliki sub-organisasi' : 'Hapus'\"\n                      :class=\"hasChildren(org.id) ? 'opacity-30 cursor-not-allowed' : ''\">\n                <i class=\"fa-solid fa-trash\" />\n              </button>\n            </td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n\n    <!-- ─── Tampilan Hierarki (Tree) ─────────────────────────────────────── -->\n    <div v-if=\"!loading && list.length > 0\" class=\"card mt-4\">\n      <div class=\"text-xs font-bold uppercase tracking-widest text-gray-400 mb-3\">\n        <i class=\"fa-solid fa-sitemap mr-1.5\" /> Struktur Hierarki\n      </div>\n      <div class=\"space-y-1 text-sm\">\n        <OrgTreeNode\n          v-for=\"root in rootOrgs\"\n          :key=\"root.id\"\n          :node=\"root\"\n          :all=\"list\"\n          :depth=\"0\" />\n      </div>\n    </div>\n\n    <!-- ─── Modal Add / Edit ──────────────────────────────────────────────── -->\n    <div v-if=\"modal.open\"\n         class=\"fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4\">\n      <div class=\"bg-navy-900 border border-navy-700 rounded-2xl w-full max-w-md shadow-2xl\">\n        <div class=\"flex items-center justify-between p-5 border-b border-navy-700\">\n          <h2 class=\"text-lg font-semibold text-white\">\n            <i class=\"fa-solid fa-sitemap text-primary-400 mr-2\" />\n            {{ modal.isNew ? 'Tambah Organisasi' : 'Edit Organisasi' }}\n          </h2>\n          <button @click=\"modal.open = false\" class=\"text-gray-400 hover:text-white\">\n            <i class=\"fa-solid fa-xmark text-xl\" />\n          </button>\n        </div>\n\n        <div class=\"p-5 space-y-4\">\n          <!-- Kode Organisasi -->\n          <div>\n            <label class=\"form-label\">\n              Kode Organisasi <span class=\"text-red-400\">*</span>\n            </label>\n            <input v-model=\"modal.form.kode\"\n                   class=\"form-input font-mono uppercase\"\n                   placeholder=\"Contoh: DIR, DIV-IT, DEPT-HR\"\n                   @input=\"modal.form.kode = modal.form.kode.toUpperCase()\" />\n            <p class=\"text-xs text-gray-500 mt-1\">Kode unik, otomatis diubah ke huruf kapital</p>\n          </div>\n\n          <!-- Nama Organisasi -->\n          <div>\n            <label class=\"form-label\">\n              Nama Organisasi <span class=\"text-red-400\">*</span>\n            </label>\n            <input v-model=\"modal.form.nama\"\n                   class=\"form-input\"\n                   placeholder=\"Contoh: Direktorat Utama\" />\n          </div>\n\n          <!-- Parent Organisasi -->\n          <div>\n            <label class=\"form-label\">Parent Organisasi</label>\n            <select v-model=\"modal.form.parent_id\" class=\"form-select\">\n              <option :value=\"null\">— Tidak ada (Root) —</option>\n              <option\n                v-for=\"org in parentOptions\"\n                :key=\"org.id\"\n                :value=\"org.id\">\n                {{ org.kode }} — {{ org.nama }}\n              </option>\n            </select>\n          </div>\n\n          <!-- Head -->\n          <div>\n            <label class=\"form-label\">Head / Kepala Organisasi</label>\n            <input v-model=\"modal.form.head\"\n                   class=\"form-input\"\n                   list=\"head-list\"\n                   placeholder=\"Nama penanggung jawab...\" />\n            <datalist id=\"head-list\">\n              <option v-for=\"u in users\" :key=\"u.id\" :value=\"u.nama\" />\n            </datalist>\n          </div>\n\n          <!-- Status (hanya saat edit) -->\n          <div v-if=\"!modal.isNew\">\n            <label class=\"form-label\">Status</label>\n            <select v-model=\"modal.form.is_active\" class=\"form-select\">\n              <option :value=\"1\">Aktif</option>\n              <option :value=\"0\">Non-aktif</option>\n            </select>\n          </div>\n\n          <!-- Error -->\n          <div v-if=\"modal.error\"\n               class=\"flex items-center gap-2 bg-red-900/30 border border-red-700/50\n                      rounded-lg px-3 py-2.5 text-sm text-red-300\">\n            <i class=\"fa-solid fa-circle-exclamation\" />\n            {{ modal.error }}\n          </div>\n        </div>\n\n        <div class=\"flex justify-end gap-3 p-5 border-t border-navy-700\">\n          <button @click=\"modal.open = false\" class=\"btn-ghost\">Batal</button>\n          <button @click=\"save\" :disabled=\"saving\" class=\"btn-primary\">\n            <i :class=\"saving ? 'fa-solid fa-circle-notch fa-spin' : 'fa-solid fa-floppy-disk'\" />\n            {{ modal.isNew ? 'Tambah' : 'Simpan' }}\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <!-- ─── Modal Konfirmasi Delete ─────────────────────────────────────── -->\n    <div v-if=\"delModal.open\"\n         class=\"fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4\">\n      <div class=\"bg-navy-900 border border-red-900/50 rounded-2xl w-full max-w-sm shadow-2xl p-6\">\n        <div class=\"flex items-center gap-3 mb-4\">\n          <div class=\"w-10 h-10 rounded-full bg-red-900/40 flex items-center justify-center\">\n            <i class=\"fa-solid fa-trash text-red-400\" />\n          </div>\n          <h2 class=\"text-lg font-semibold text-white\">Hapus Organisasi</h2>\n        </div>\n        <p class=\"text-sm text-gray-300 mb-1\">\n          Hapus <strong class=\"text-white\">{{ delModal.org?.nama }}</strong>?\n        </p>\n        <p class=\"text-xs text-gray-500 mb-5\">\n          Kode: <span class=\"font-mono text-gray-400\">{{ delModal.org?.kode }}</span>\n        </p>\n        <div v-if=\"delModal.error\"\n             class=\"flex items-center gap-2 bg-red-900/30 border border-red-700/50\n                    rounded-lg px-3 py-2.5 text-sm text-red-300 mb-4\">\n          <i class=\"fa-solid fa-circle-exclamation\" />\n          {{ delModal.error }}\n        </div>\n        <div class=\"flex justify-end gap-3\">\n          <button @click=\"delModal.open = false\" class=\"btn-ghost\">Batal</button>\n          <button @click=\"doDelete\" :disabled=\"saving\"\n                  class=\"px-4 py-2 rounded-lg bg-red-600 hover:bg-red-500 text-white\n                         text-sm font-medium transition-colors\">\n            <i v-if=\"saving\" class=\"fa-solid fa-circle-notch fa-spin mr-1\" />\n            Hapus\n          </button>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\ndefinePageMeta({ layout: 'default' })\n\nconst { get, post, put, del } = useApi()\n\n// ── State ──────────────────────────────────────────────────────────────────\nconst loading = ref(true)\nconst saving  = ref(false)\nconst list    = ref<any[]>([])\nconst users   = ref<any[]>([])\n\nconst toast   = reactive({ show: false, type: 'success', msg: '' })\nconst modal   = reactive({\n  open: false, isNew: false, error: '',\n  form: { kode: '', nama: '', parent_id: null as number | null, head: '', is_active: 1 },\n})\nconst delModal = reactive({ open: false, org: null as any, error: '' })\n\n// ── Data fetching ──────────────────────────────────────────────────────────\nasync function loadData() {\n  loading.value = true\n  try {\n    const [orgs, usersData] = await Promise.all([\n      get('/v1/master/organizations'),\n      get('/v1/master/users'),\n    ])\n    list.value  = orgs  || []\n    users.value = usersData || []\n  } finally {\n    loading.value = false\n  }\n}\n\n// ── Computed ───────────────────────────────────────────────────────────────\nconst rootOrgs = computed(() => list.value.filter((o: any) => !o.parent_id))\n\n// Opsi parent dropdown (exclude diri sendiri saat edit)\nconst parentOptions = computed(() =>\n  list.value.filter((o: any) => o.id !== modal.form['id'])\n)\n\nfunction hasChildren(id: number): boolean {\n  return list.value.some((o: any) => o.parent_id === id)\n}\n\n// ── Modal helpers ──────────────────────────────────────────────────────────\nfunction openAdd() {\n  modal.isNew  = true\n  modal.error  = ''\n  modal.form   = { kode: '', nama: '', parent_id: null, head: '', is_active: 1 }\n  modal.open   = true\n}\n\nfunction openEdit(org: any) {\n  modal.isNew = false\n  modal.error = ''\n  modal.form  = {\n    id: org.id,\n    kode: org.kode,\n    nama: org.nama,\n    parent_id: org.parent_id,\n    head: org.head || '',\n    is_active: org.is_active,\n  }\n  modal.open = true\n}\n\nasync function save() {\n  if (!modal.form.kode || !modal.form.nama) {\n    modal.error = 'Kode dan Nama wajib diisi'\n    return\n  }\n  saving.value = true\n  modal.error  = ''\n  try {\n    if (modal.isNew) {\n      await post('/v1/master/organizations', modal.form)\n    } else {\n      await put(`/v1/master/organizations/${(modal.form as any).id}`, modal.form)\n    }\n    modal.open = false\n    showToast('success', modal.isNew ? 'Organisasi berhasil ditambahkan' : 'Data berhasil diperbarui')\n    await loadData()\n  } catch (e: any) {\n    modal.error = e?.data?.message || 'Terjadi kesalahan'\n  } finally {\n    saving.value = false\n  }\n}\n\nfunction confirmDelete(org: any) {\n  if (hasChildren(org.id)) return   // tombol disabled\n  delModal.org   = org\n  delModal.error = ''\n  delModal.open  = true\n}\n\nasync function doDelete() {\n  saving.value   = true\n  delModal.error = ''\n  try {\n    await del(`/v1/master/organizations/${delModal.org.id}`)\n    delModal.open = false\n    showToast('success', 'Organisasi berhasil dihapus')\n    await loadData()\n  } catch (e: any) {\n    delModal.error = e?.data?.message || 'Gagal menghapus'\n  } finally {\n    saving.value = false\n  }\n}\n\n// ── Toast ──────────────────────────────────────────────────────────────────\nfunction showToast(type: 'success' | 'error', msg: string) {\n  toast.type = type\n  toast.msg  = msg\n  toast.show = true\n  setTimeout(() => { toast.show = false }, 3000)\n}\n\nonMounted(loadData)\n</script>\n"],"version":3}