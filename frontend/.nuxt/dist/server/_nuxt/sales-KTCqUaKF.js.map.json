{"file":"sales-KTCqUaKF.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;AAgGA,UAAM,EAAE,IAAS,IAAI,OAAA;AAErB,UAAM,UAAW,IAAiB,IAAI;AACtC,UAAM,SAAW,IAAI,KAAK;AAC1B,UAAM,WAAW,SAAS,EAAE,MAAM,IAAI,OAAO,IAAI,SAAS,GAAG,WAAW,GAAG,iBAAiB,GAAG;AAE/F,aAAS,UAAU,GAAmB;AACpC,aAAO,IAAI,KAAK,aAAa,SAAS,EAAE,OAAO,YAAY,UAAU,OAAO,uBAAuB,EAAA,CAAG,EAAE,OAAO,CAAC;AAAA,IAClH;AACA,UAAM,QAAW,SAAS,EAAE,MAAM,OAAO,KAAK,IAAI,MAAM,WAAgC;AAExF,UAAM,EAAE,MAAM,SAAS,aAAY,CAAA,QAAA,SAAA,IAAAA,iBAAA,MAAM,aAAa,gBAAgB,MAAM,IAAI,kBAAkB,GAAG,EAAE,QAAQ,MAAA,CAAO,CAAA;AACtH,UAAM,EAAE,MAAM,MAAA,KAAU,CAAA,QAAA,SAAA,IAAAA,iBAAA,MAAM,aAAa,cAAc,MAAM,IAAI,kBAAkB,GAAG,EAAE,QAAQ,OAAO,CAAA;;;AA3GlG,YAAA,OAAAC,eAAAC,WAAA,EAAA,OAAM,eAAW,MAAA,CAAA,CAAA,wSAAA;AAUP,UAAAC,MAAA,KAAA,EAAM,MAAI;6BACRC,eAAA,CAAAD,MAAA,KAAA,EAAM,SAAI,YAAA,kCAAA,6BAAA,oHAAA,CAAA,gCAEVC,eAAAD,MAAA,KAAA,EAAM,SAAI,YAAA,4CAAA,6CAAA,2BAClBE,eAAAF,MAAA,KAAA,EAAM,GAAG;;;;UAILA,MAAA,OAAA,GAAO;;;;AAiBIG,sBAAAH,MAAA,IAAA,IAAL,MAAC;;cACMA,MAAA,OAAA,MAAY,EAAE,IAAE;uDACVI,cAAA,SAAAJ,MAAA,QAAA,EAAS,IAAI,oFACbI,cAAA,SAAAJ,MAAA,QAAA,EAAS,KAAK;AAGVG,0BAAAH,MAAA,KAAA,IAAL,MAAC;4CAAwB,SAAO,EAAE,EAAE,oBADpCK,sBAAA,MAAA,QAAAL,MAAA,QAAA,EAAS,OAAO,IAAhBM,gBAAAN,MAAA,QAAA,EAAS,SACuB,EAAE,EAAE,IADpCO,cAAAP,MAAA,QAAA,EAAS,SACuB,EAAE,EAAE,CAAA,IAAA,cAAA,MAAKE,eAAA,EAAE,IAAI;;wJAKrDE,cAAA,SAAO,CAAC,oBADFC,sBAAA,MAAA,QAAAL,MAAA,QAAA,EAAS,SAAS,oBAAlBA,MAAA,QAAA,EAAS,WACR,CAAC,kBADFA,MAAA,QAAA,EAAS,WACR,CAAC,CAAA,IAAA,cAAA,2BACRI,cAAA,SAAO,CAAC,oBAFFC,sBAAA,MAAA,QAAAL,MAAA,QAAA,EAAS,SAAS,oBAAlBA,MAAA,QAAA,EAAS,WAER,CAAC,kBAFFA,MAAA,QAAA,EAAS,WAER,CAAC,CAAA,IAAA,cAAA;;cAII,YAAAA,MAAA,QAAA,EAAS;AAAA,cAAT,uBAAA,CAAA,WAAAA,MAAA,QAAA,EAAS,kBAAe;AAAA,cAAE,OAAM;AAAA,YAAA;yLAIyBA,MAAA,MAAA,CAAM,IAAA,cAAA,+CACvEA,MAAA,MAAA,IAAM,qCAAA,mBAAA;;mFASkBE,eAAA,EAAE,IAAI,2DACVA,eAAA,EAAE,KAAK,0CAEdD,eAAA,CAAA,EAAE,cAAS,UAAA,eAA8B,EAAE,cAAS,YAAA,iBAAA,cAAA,OAAA,CAAA,sBAC3EC,eAAA,EAAE,SAAS,qEAIFD,eAAA,EAAE,YAAS,sBAAA,iBAAA,sBACpBC,eAAA,EAAE,YAAS,UAAA,UAAA,6EAIbA,eAAA,EAAE,kBAAe,IAAO,UAAU,EAAE,eAAe,IAAA,GAAA;;;;;;;;;;;;;;;;;","names":["_withAsyncContext","_ssrRenderAttrs","_mergeProps","_unref","_ssrRenderClass","_ssrInterpolate","_ssrRenderList","_ssrRenderAttr","_ssrIncludeBooleanAttr","_ssrLooseContain","_ssrLooseEqual"],"sources":["../../../../pages/sales.vue"],"sourcesContent":["<template>\n  <div class=\"max-w-4xl\">\n    <div class=\"page-header\">\n      <div>\n        <h1 class=\"page-title\"><i class=\"fa-solid fa-users text-primary-400 mr-2\" />Master Sales</h1>\n        <p class=\"page-subtitle\">Daftar user sales & manager</p>\n      </div>\n    </div>\n\n    <!-- Toast -->\n    <Transition name=\"toast\">\n      <div v-if=\"toast.show\"\n           :class=\"toast.type === 'success' ? 'bg-green-800 border-green-600' : 'bg-red-900 border-red-600'\"\n           class=\"fixed top-5 right-5 z-50 flex items-center gap-3 px-4 py-3 rounded-lg border shadow-xl text-sm text-white max-w-sm\">\n        <i :class=\"toast.type === 'success' ? 'fa-solid fa-circle-check text-green-400' : 'fa-solid fa-circle-exclamation text-red-400'\" />\n        {{ toast.msg }}\n      </div>\n    </Transition>\n\n    <div v-if=\"pending\" class=\"flex justify-center py-20\">\n      <i class=\"fa-solid fa-circle-notch fa-spin text-3xl text-primary-400\" />\n    </div>\n\n    <div v-else class=\"card overflow-x-auto\">\n      <table class=\"tbl\">\n        <thead>\n          <tr>\n            <th>Nama</th>\n            <th>Email</th>\n            <th>Role</th>\n            <th class=\"text-center\">Status</th>\n            <th class=\"text-right\">Limit Entertain/Bln</th>\n            <th class=\"text-center\">Aksi</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr v-for=\"u in data\" :key=\"u.id\">\n            <template v-if=\"editing === u.id\">\n              <td><input v-model=\"editForm.nama\" class=\"form-input py-1 text-sm\" /></td>\n              <td><input v-model=\"editForm.email\" class=\"form-input py-1 text-sm\" /></td>\n              <td>\n                <select v-model=\"editForm.role_id\" class=\"form-select py-1 text-sm\">\n                  <option v-for=\"r in roles\" :key=\"r.id\" :value=\"r.id\">{{ r.nama }}</option>\n                </select>\n              </td>\n              <td class=\"text-center\">\n                <select v-model=\"editForm.is_active\" class=\"form-select py-1 text-sm w-24\">\n                  <option :value=\"1\">Aktif</option>\n                  <option :value=\"0\">Nonaktif</option>\n                </select>\n              </td>\n              <td class=\"text-right\">\n                <NumericInput v-model=\"editForm.entertain_limit\" class=\"form-input py-1 text-sm w-36 text-right\" />\n              </td>\n              <td class=\"text-center\">\n                <div class=\"flex justify-center gap-1\">\n                  <button @click=\"saveUser(u.id)\" class=\"btn-primary btn-xs rounded\" :disabled=\"saving\">\n                    <i :class=\"saving ? 'fa-solid fa-circle-notch fa-spin' : 'fa-solid fa-check'\" />\n                  </button>\n                  <button @click=\"editing = null\" class=\"btn-secondary btn-xs rounded\">\n                    <i class=\"fa-solid fa-xmark\" />\n                  </button>\n                </div>\n              </td>\n            </template>\n            <template v-else>\n              <td class=\"font-medium text-gray-200\">{{ u.nama }}</td>\n              <td class=\"text-gray-400 text-sm\">{{ u.email }}</td>\n              <td>\n                <span class=\"badge\" :class=\"u.role_nama === 'Admin' ? 'badge-blue' : u.role_nama === 'Manager' ? 'badge-yellow' : 'badge-gray'\">\n                  {{ u.role_nama }}\n                </span>\n              </td>\n              <td class=\"text-center\">\n                <span :class=\"u.is_active ? 'badge badge-green' : 'badge badge-red'\">\n                  {{ u.is_active ? 'Aktif' : 'Nonaktif' }}\n                </span>\n              </td>\n              <td class=\"text-right text-sm text-gray-400\">\n                {{ u.entertain_limit > 0 ? fmtRupiah(u.entertain_limit) : '—' }}\n              </td>\n              <td class=\"text-center\">\n                <button @click=\"startEdit(u)\" class=\"btn-ghost btn-xs rounded\" title=\"Edit\">\n                  <i class=\"fa-solid fa-pen text-xs\" />\n                </button>\n              </td>\n            </template>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\ndefinePageMeta({ middleware: 'auth' })\nconst { get, put } = useApi()\n\nconst editing  = ref<number|null>(null)\nconst saving   = ref(false)\nconst editForm = reactive({ nama: '', email: '', role_id: 3, is_active: 1, entertain_limit: 0 })\n\nfunction fmtRupiah(v: number): string {\n  return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(v)\n}\nconst toast    = reactive({ show: false, msg: '', type: 'success' as 'success'|'error' })\n\nconst { data, pending, refresh } = await useAsyncData('sales-master', () => get('/v1/master/sales'), { server: false })\nconst { data: roles } = await useAsyncData('roles-list', () => get('/v1/master/roles'), { server: false })\n\nfunction showToast(msg: string, type: 'success'|'error' = 'success') {\n  toast.msg = msg; toast.type = type; toast.show = true\n  setTimeout(() => { toast.show = false }, 3000)\n}\n\nfunction startEdit(u: any) {\n  editing.value = u.id\n  editForm.nama = u.nama\n  editForm.email = u.email\n  editForm.role_id = u.role_id\n  editForm.is_active = u.is_active\n  editForm.entertain_limit = u.entertain_limit || 0\n}\n\nasync function saveUser(id: number) {\n  saving.value = true\n  try {\n    await put(`/v1/master/users/${id}`, { ...editForm })\n    showToast('User berhasil diupdate.')\n    editing.value = null\n    await refresh()\n  } catch (err: any) {\n    showToast(err?.data?.detail || 'Gagal menyimpan.', 'error')\n  } finally {\n    saving.value = false\n  }\n}\n</script>\n\n<style scoped>\n.badge { @apply inline-block px-2 py-0.5 rounded text-xs font-medium; }\n.badge-blue   { @apply bg-blue-900/50 text-blue-300; }\n.badge-yellow { @apply bg-yellow-900/50 text-yellow-300; }\n.badge-gray   { @apply bg-gray-800 text-gray-400; }\n.badge-green  { @apply bg-green-900/50 text-green-300; }\n.badge-red    { @apply bg-red-900/50 text-red-400; }\n.toast-enter-active, .toast-leave-active { transition: all 0.3s ease; }\n.toast-enter-from, .toast-leave-to { opacity: 0; transform: translateX(20px); }\n</style>\n"],"version":3}