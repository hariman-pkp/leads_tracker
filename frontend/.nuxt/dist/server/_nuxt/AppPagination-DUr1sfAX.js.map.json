{"file":"AppPagination-DUr1sfAX.js","mappings":";;;;;;;;;;;;;;;AAgDA,UAAM,QAAQ;AAaE,aAAS,MAAM,MAAM,kBAAkB,CAAC,IAAI,IAAI,IAAI,EAAE,CAAC;AAEvE,UAAM,OAAO,SAAS,MAAM,MAAM,UAAU,IAAI,KAAK,MAAM,OAAO,KAAK,MAAM,UAAU,CAAC;AACxF,UAAM,KAAO,SAAS,MAAM,KAAK,IAAI,MAAM,OAAO,MAAM,SAAS,MAAM,KAAK,CAAC;AAY7E,UAAM,QAAQ,SAAS,MAAM;AAC3B,YAAM,QAAQ,MAAM;AACpB,YAAM,MAAQ,MAAM;AACpB,UAAI,SAAS,EAAG,QAAO,MAAM,KAAK,EAAE,QAAQ,MAAA,GAAS,CAAC,GAAG,MAAM,IAAI,CAAC;AACpE,YAAM,SAA8B,CAAC,CAAC;AACtC,UAAI,MAAM,EAAG,QAAO,KAAK,KAAK;AAC9B,eAAS,IAAI,KAAK,IAAI,GAAG,MAAM,CAAC,GAAG,KAAK,KAAK,IAAI,QAAQ,GAAG,MAAM,CAAC,GAAG,IAAK,QAAO,KAAK,CAAC;AACxF,UAAI,MAAM,QAAQ,EAAG,QAAO,KAAK,KAAK;AACtC,aAAO,KAAK,KAAK;AACjB,aAAO;AAAA,IACT,CAAC;;UArFY,QAAA,aAAU,GAAA;qBAAMA,eAAAC,WAAA,EAAA,OAAM,uDAAmD,MAAA,CAAA,uFAG7EC,MAAA,IAAA,CAAI,oBAAOA,MAAA,EAAA,CAAE,yBAAY,QAAA,KAAK,kGAMC,QAAA,SAAI,CAAA,IAAA,cAAA,8IAIG,QAAA,SAAI,CAAA,IAAA,cAAA;AAKvBC,sBAAAD,MAAA,KAAA,IAAL,MAAC;;cACJ,MAAC,OAAA;;;oCAEGE,eAAA,MAAM,QAAA,OAAI,kBAAA,QAAA,qCACrB,CAAC;;;;gCAKiCC,sBAAA,QAAA,SAAS,QAAA,UAAU,IAAA,cAAA,wHAIjBA,sBAAA,QAAA,SAAS,QAAA,UAAU,IAAA,cAAA,kPAQrDC,cAAA,SAAO,QAAA,OAAO;AACDH,sBAAA,QAAA,iBAAL,MAAC;0BAA8BG,cAAA,SAAO,CAAC,oCAAK,CAAC;;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_unref","_ssrRenderList","_ssrRenderClass","_ssrIncludeBooleanAttr","_ssrRenderAttr"],"sources":["../../../../components/AppPagination.vue"],"sourcesContent":["<template>\n  <div v-if=\"totalPages > 1\" class=\"flex items-center justify-between gap-4 mt-4 px-1\">\n    <!-- Info -->\n    <div class=\"text-xs text-gray-500\">\n      {{ from }}–{{ to }} dari {{ total }} data\n    </div>\n\n    <!-- Controls -->\n    <div class=\"flex items-center gap-1\">\n      <!-- First -->\n      <button @click=\"go(1)\" :disabled=\"page === 1\" class=\"pg-btn\">\n        <i class=\"fa-solid fa-angles-left text-[10px]\" />\n      </button>\n      <!-- Prev -->\n      <button @click=\"go(page - 1)\" :disabled=\"page === 1\" class=\"pg-btn\">\n        <i class=\"fa-solid fa-angle-left text-[10px]\" />\n      </button>\n\n      <!-- Page numbers -->\n      <template v-for=\"p in pages\" :key=\"p\">\n        <span v-if=\"p === '...'\" class=\"px-1 text-gray-600 text-xs select-none\">…</span>\n        <button v-else @click=\"go(p as number)\"\n                :class=\"p === page ? 'pg-btn-active' : 'pg-btn'\">\n          {{ p }}\n        </button>\n      </template>\n\n      <!-- Next -->\n      <button @click=\"go(page + 1)\" :disabled=\"page === totalPages\" class=\"pg-btn\">\n        <i class=\"fa-solid fa-angle-right text-[10px]\" />\n      </button>\n      <!-- Last -->\n      <button @click=\"go(totalPages)\" :disabled=\"page === totalPages\" class=\"pg-btn\">\n        <i class=\"fa-solid fa-angles-right text-[10px]\" />\n      </button>\n    </div>\n\n    <!-- Per page selector -->\n    <div class=\"flex items-center gap-2 text-xs text-gray-500\">\n      <span>Per halaman</span>\n      <select :value=\"perPage\" @change=\"changePerPage\" class=\"form-select text-xs py-1 w-16\">\n        <option v-for=\"n in perPageOptions\" :key=\"n\" :value=\"n\">{{ n }}</option>\n      </select>\n    </div>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nconst props = defineProps<{\n  page: number\n  perPage: number\n  total: number\n  totalPages: number\n  perPageOptions?: number[]\n}>()\n\nconst emit = defineEmits<{\n  (e: 'update:page', v: number): void\n  (e: 'update:perPage', v: number): void\n}>()\n\nconst options = computed(() => props.perPageOptions ?? [10, 20, 25, 50])\n\nconst from = computed(() => props.total === 0 ? 0 : (props.page - 1) * props.perPage + 1)\nconst to   = computed(() => Math.min(props.page * props.perPage, props.total))\n\nfunction go(p: number) {\n  if (p < 1 || p > props.totalPages || p === props.page) return\n  emit('update:page', p)\n}\n\nfunction changePerPage(e: Event) {\n  emit('update:perPage', Number((e.target as HTMLSelectElement).value))\n  emit('update:page', 1)\n}\n\nconst pages = computed(() => {\n  const total = props.totalPages\n  const cur   = props.page\n  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1)\n  const result: (number | string)[] = [1]\n  if (cur > 3) result.push('...')\n  for (let p = Math.max(2, cur - 1); p <= Math.min(total - 1, cur + 1); p++) result.push(p)\n  if (cur < total - 2) result.push('...')\n  result.push(total)\n  return result\n})\n</script>\n\n<style scoped>\n.pg-btn {\n  @apply flex items-center justify-center w-7 h-7 rounded text-xs text-gray-400\n         hover:bg-gray-700 hover:text-white disabled:opacity-30 disabled:cursor-not-allowed\n         transition-colors;\n}\n.pg-btn-active {\n  @apply flex items-center justify-center w-7 h-7 rounded text-xs font-bold\n         bg-primary-600 text-white;\n}\n</style>\n"],"version":3}